# Single env for the whole monorepo — copy to .env at the repo ROOT:
#   cp .env.example .env
# Local dev reads it via the API (ConfigModule loads ../../.env from apps/api);
# production reads it via docker-compose.prod.yml (env_file: .env). Values below
# are dev-friendly defaults — comments note what to change for production.

# --- Web build (baked into the JS bundle at docker build time) ---
# Must include the /api prefix — the client appends paths like /feed, /image.
# Dev mobile overrides this via its own EXPO_PUBLIC_API_URL (defaults to localhost).
EXPO_PUBLIC_API_URL=https://flowpedia-api.julsql.fr/api

# --- Host ports (docker prod; the host nginx reverse-proxies these) ---
WEB_PORT=8110
API_PORT=8111

# --- API ---
PORT=3000
# Required by Wikimedia — use a valid contact.
WIKIPEDIA_USER_AGENT=Flowpedia/0.1 (https://github.com/JulSql/flowpedia; contact@flowpedia.julsql.fr)
# Default Wikipedia content language (overridable per request via ?lang=).
WIKIPEDIA_LANG=fr
# Article cache TTL in seconds.
ARTICLE_CACHE_TTL=86400

# --- Postgres (user-signal persistence) ---
# Dev: connect to the docker infra (`pnpm infra:up`) on host :5433.
DATABASE_URL=postgresql://flowpedia:flowpedia@localhost:5433/flowpedia
# Prod: docker-compose builds DATABASE_URL from these (override the password!).
POSTGRES_USER=flowpedia
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=flowpedia

# --- Redis (cache; in-memory fallback if unset/unreachable) ---
REDIS_URL=redis://localhost:6379

# --- Auth (accounts) ---
# MUST be a long random string in production (tokens are forgeable otherwise).
JWT_SECRET=flowpedia-dev-secret-change-me
JWT_EXPIRES_IN=30d
# Web origin of the app — where the /reset/<uid>/<token> screen is served, so the
# emailed reset link opens it (NOT the API origin). Prod: https://flowpedia.julsql.fr
APP_URL=http://localhost:3000

# --- Email reset (Gmail SMTP) ---
# Leave USER/PASSWORD empty to log reset links to the console instead of sending.
# Real emails: a Gmail address + a Gmail *app password*
# (https://myaccount.google.com/apppasswords — not the login password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Recommendation embeddings (Phase 2) ---
# Off by default. Set to 1 AND install the optional dep
# (`pnpm --filter @flowpedia/api add @huggingface/transformers`) to enable
# embedding-based taste ranking + MMR. Needs a database to cache vectors.
RECO_EMBEDDINGS=0

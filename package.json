{
  "name": "flowpedia",
  "version": "0.1.0",
  "private": true,
  "description": "Flowpedia — a social-style feed of Wikipedia articles",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "pnpm --filter @flowpedia/api start:dev",
    "mobile": "pnpm --filter @flowpedia/mobile start",
    "mobile:clear": "pnpm --filter @flowpedia/mobile start:clear",
    "mobile:web": "pnpm --filter @flowpedia/mobile web",
    "mobile:android": "pnpm --filter @flowpedia/mobile android",
    "build:shared": "pnpm --filter @flowpedia/shared build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "patchedDependencies": {
      "expo-speech@14.0.8": "patches/expo-speech@14.0.8.patch"
    },
    "overrides": {
      "ajv": ">=8.18.0",
      "body-parser@^1": "^1.20.6",
      "brace-expansion@^1": "^1.1.18",
      "brace-expansion@^2": "^2.1.4",
      "brace-expansion@^5": "^5.0.9",
      "fast-uri@^3": "^3.1.5",
      "file-type": ">=21.3.2",
      "glob": ">=10.5.0",
      "js-yaml@^3": "^3.15.1",
      "js-yaml@^4": "^4.3.1",
      "lodash": ">=4.18.0",
      "multer": ">=2.2.0",
      "nanoid@^3": "^3.3.18",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "postcss@^8": "^8.5.26",
      "qs": ">=6.15.2",
      "sharp@^0.34": "^0.35.0",
      "socket.io-parser@^4": "^4.2.7",
      "tar@^7": "^7.5.21",
      "tmp": ">=0.2.6",
      "undici@^6": "^6.28.0",
      "uuid": ">=11.1.1",
      "webpack": ">=5.104.1"
    }
  }
}
